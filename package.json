{
  "name": "eslint-plugin-better-ssr",
  "version": "2.0.0",
  "description": "Modern TypeScript fork of eslint-plugin-ssr-friendly with ESLint 9/10, flat config, and Next.js App Router support",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kopiro/eslint-plugin-ssr-friendly"
  },
  "homepage": "https://github.com/kopiro/eslint-plugin-ssr-friendly",
  "bugs": "https://github.com/kopiro/eslint-plugin-ssr-friendly/issues",
  "keywords": [
    "eslint",
    "eslintplugin",
    "ssr",
    "server-side-rendering",
    "globals",
    "react",
    "nextjs",
    "typescript",
    "flat-config"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "test": "ts-node --project tsconfig.test.json test/index.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "globals": "^13.24.0"
  },
  "peerDependencies": {
    "eslint": "^8.0.0 || ^9.0.0 || ^10.0.0"
  },
  "peerDependenciesMeta": {
    "@typescript-eslint/parser": {
      "optional": true
    }
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  }
}
